# Copy to .env and fill in. Only the first block is required.

# --- Required ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your Telegram user id (ask @userinfobot). The bot answers nobody else.
TELEGRAM_OWNER_ID=
# Your Obsidian vault. Relative paths resolve from this folder. Try the example first.
VAULT_DIR=example-vault

# --- The agent ---
AGENT_NAME=Keep
# IANA time zone for schedules and timestamps. Defaults to the machine's.
# TZ_NAME=America/New_York
CHAT_MODEL=sonnet
JOB_MODEL=sonnet
# Tried once when the usage limit refuses a run.
# LIMIT_FALLBACK_MODEL=haiku
# default | acceptEdits | bypassPermissions. acceptEdits lets it write notes but keeps the shell
# to the read-only commands in src/claude.ts. bypassPermissions lets it run anything: only on a
# machine you'd hand to a stranger who has read your notes.
PERMISSION_MODE=acceptEdits
CLAUDE_TIMEOUT_MS=600000

# --- Memory ---
# Pull before every run, commit and push after. Needs the vault to be a git repo with a remote.
GIT_SYNC=false
# A conversation is filed into the vault and closed after this much silence.
SESSION_IDLE_HOURS=6
AGENTS_DIR=Agents
DAILY_DIR=Daily

# --- Browser (optional) ---
# Give the agent a browser for JavaScript-heavy pages and forms (npx playwright install chromium).
# BROWSER=true
# A real Chromium with a saved profile, which you can take over from your phone when the agent
# hits a captcha or a login. Logins stick: never sign into email or banking in it.
# BROWSER_LIVE=true
# HANDOFF_WAIT_MS=300000
# BROWSER_CDP_PORT=9223
# BROWSER_EXECUTABLE=

# --- The /live page (only with BROWSER_LIVE) ---
# Bind to a private address: a Tailscale IP, or 127.0.0.1 behind an SSH tunnel. Empty = off.
WEB_HOST=127.0.0.1
WEB_PORT=8787
# The address you'd open on your phone, if it isn't WEB_HOST (e.g. http://my-box.tailnet.ts.net:8787).
# PUBLIC_URL=
